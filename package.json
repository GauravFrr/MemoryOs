    "queue:verify": "tsx scripts/verify-queues.ts",
    "redis:dev": "tsx scripts/start-redis-dev.ts"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "tsx": "^4.19.4",
    "turbo": "latest",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@memoryos/queue": "workspace:*",
    "@prisma/client": "^6.9.0",
    "bullmq": "^5.53.2",
    "dotenv": "^16.5.0",
    "ioredis": "^5.6.1",
    "prisma": "^6.9.0"
  },
  "packageManager": "pnpm@9.1.0"
