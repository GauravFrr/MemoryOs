# Postgres connection string to Supabase (or local DB)
# Enable pgvector in Supabase: Database → Extensions → vector
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/memoryos"

# Redis for BullMQ (local Docker or Railway)
REDIS_URL="redis://localhost:6379"

# Gemini API
GEMINI_API_KEY=""

# Clerk Auth
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SECRET=""
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# General
PORT="3000"
NEXT_PUBLIC_API_URL="http://localhost:3000"
